    },
    {
      "input": "STEP/A7_LevelBeam_Filled.step", "mode": "view",
      "display": {"mode": "shaded_edges"},
      "outputs": [
        {"path": "reviews/A7_Filled_front_edges.png", "camera": "right"},
        {"path": "reviews/A7_Filled_rear_edges.png", "camera": "left"}
